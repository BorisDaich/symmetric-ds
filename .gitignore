**/.factorypath
**/.apt_generated/
**/.springBeans
*.iml

# Build temp / logs
*.log
hs_err_pid*.log
replay_pid*.log

# Allow build.gradle even if it lives under bin/ (some modules check it in)
!**/bin/build.gradle
